# Hashed Astro assets — cache forever
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# WebP images & OG image — short cache (CDN re-validates)
/images/*
  Cache-Control: public, max-age=86400
/og-default.png
  Cache-Control: public, max-age=86400
/og-china-best-time.webp
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
