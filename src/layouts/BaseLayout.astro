---
// BaseLayout.astro - Design Read: travel planning content-tool hybrid
// Dial: VARIANCE=6 MOTION=5 DENSITY=4
// Aesthetic: Tailwind + custom teal accent + Geist + restrained motion
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
}

const { title, description, ogImage = "/og-default.png" } = Astro.props;
// og:image 统一转为绝对 URL（社交平台抓取器无法解析相对路径）
const ogImageURL = ogImage.startsWith("http") ? ogImage : new URL(ogImage, Astro.site).href;
let canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
// 全站规范：URL 无尾斜杠（trailingSlash: never），首页 pathname 为 "/" 需去除
if (canonicalURL.endsWith("/")) canonicalURL = canonicalURL.slice(0, -1);

// BreadcrumbList — only for subpages
const pageLabels: Record<string, string> = {
  "when-to-go": "When to Go Quiz",
  "monthly-guide": "Month-by-Month Guide",
  "by-region": "By Region",
  "festivals": "Festivals",
  "crowd-calendar": "Crowd Calendar",
  "faq": "FAQ",
  "travel-cost": "Travel Cost",
  "about": "About",
  "contact": "Contact",
  "privacy": "Privacy",
  "404": "404",
};
let breadcrumbSchema = "";
let crumbs: { name: string; item: string }[] = [];
const pathParts = Astro.url.pathname.split('/').filter(Boolean);
if (pathParts.length > 0) {
  const baseUrl = canonicalURL.replace(Astro.url.pathname, '/');
  const items = [{ "@type": "ListItem", "position": 1, "name": "Home", "item": baseUrl }];
  crumbs.push({ name: "Home", item: baseUrl });
  for (let i = 0; i < pathParts.length; i++) {
    const part = pathParts[i];
    const name = pageLabels[part] ?? part.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
    const item = baseUrl + pathParts.slice(0, i + 1).join('/');
    items.push({ "@type": "ListItem", "position": (i + 2), "name": name, "item": item });
    crumbs.push({ name, item });
  }
  breadcrumbSchema = JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": items });
}
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>document.documentElement.classList.add('js');</script>
    {breadcrumbSchema && <>
      <!-- BreadcrumbList Schema -->
      <script type="application/ld+json" set:html={breadcrumbSchema} />
    </>}
    <!-- Organization + WebSite Schema -->
    <script type="application/ld+json" set:html={`{
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "When to Visit China",
      "url": "https://best-time-to-visit-china.com",
      "logo": "https://best-time-to-visit-china.com/favicon.svg",
      "description": "Expert travel guide helping you find the best time to visit China. Month-by-month weather, crowd calendars, festival dates, and region-specific advice."
    }`} />
    <script type="application/ld+json" set:html={`{
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "When to Visit China",
      "url": "https://best-time-to-visit-china.com"
    }`} />
    <!-- Person Schema (Author) -->
    <script type="application/ld+json" set:html={`{
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Wei Zhang",
      "jobTitle": "Founder & Lead Editor",
      "url": "https://best-time-to-visit-china.com/about",
      "description": "Travel writer and China specialist with over a decade of firsthand experience across 20+ Chinese cities. Founder of When to Visit China."
    }`} />
  </head>
  <body class="bg-white text-zinc-900 antialiased font-sans">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-accent-600 focus:text-white focus:rounded-lg focus:outline-none">Skip to content</a>

    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="max-w-7xl mx-auto px-4 pt-4">
        <ol class="flex flex-wrap items-center gap-1.5 text-xs text-zinc-400">
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-1.5">
              {i > 0 && <span aria-hidden="true" class="text-zinc-300">/</span>}
              {i < crumbs.length - 1 ? (
                <a href={c.item} class="hover:text-accent-600 transition-colors">{c.name}</a>
              ) : (
                <span class="text-zinc-500 font-medium" aria-current="page">{c.name}</span>
              )}
            </li>
          ))}
        </ol>
      </nav>
    )}

    <main id="main-content"><slot /></main>

    <!-- ======== PAGE HELPFULNESS FEEDBACK ======== -->
    <div id="helpful-widget" class="max-w-7xl mx-auto px-4 pb-10">
      <div class="flex items-center justify-between gap-4 border border-zinc-200 rounded-xl bg-zinc-50 px-5 py-4" data-state="idle">
        <p class="text-sm font-medium text-zinc-700">Was this page helpful?</p>
        <div class="flex items-center gap-2" data-buttons>
          <button type="button" class="inline-flex items-center gap-1.5 px-4 py-1.5 text-sm font-semibold rounded-full border border-zinc-300 hover:border-accent-400 hover:text-accent-600 transition-colors" data-vote="yes">Yes</button>
          <button type="button" class="inline-flex items-center gap-1.5 px-4 py-1.5 text-sm font-semibold rounded-full border border-zinc-300 hover:border-accent-400 hover:text-accent-600 transition-colors" data-vote="no">No</button>
        </div>
      </div>
      <p class="hidden text-sm text-emerald-600 font-medium px-5 py-4" data-thanks>Thanks for your feedback.</p>
    </div>
  </body>
  <script>
    (function () {
      var key = "helpful:" + location.pathname;
      var stored = null;
      try { stored = localStorage.getItem(key); } catch (e) {}
      if (stored) {
        var card = document.querySelector("#helpful-widget [data-state]");
        if (card) card.classList.add("hidden");
        var thanks = document.querySelector("#helpful-widget [data-thanks]");
        if (thanks) { thanks.classList.remove("hidden"); thanks.textContent = "Thanks for your feedback."; }
      }
      var buttons = document.querySelectorAll("#helpful-widget [data-vote]");
      buttons.forEach(function (btn) {
        btn.addEventListener("click", function () {
          var card = document.querySelector("#helpful-widget [data-state]");
          var thanks = document.querySelector("#helpful-widget [data-thanks]");
          if (card) card.classList.add("hidden");
          if (thanks) { thanks.classList.remove("hidden"); thanks.textContent = "Thanks for your feedback."; }
          try { localStorage.setItem(key, btn.getAttribute("data-vote")); } catch (e) {}
        });
      });
    })();
  </script>
</html>
