---
import "../../styles/global.css";
import { imgSrcset } from "../../lib/img";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { monthlyData, monthRegionSlugs } from "../../data/weather.ts";
import { regionGuides } from "../../data/regions.ts";
import Icon from "../../components/Icon.astro";
import ChinaMap from "../../components/islands/ChinaMap";
import CostChart from "../../components/islands/CostChart";
import HotelComparison from "../../components/islands/HotelComparison";
import ComparisonTool from "../../components/islands/ComparisonTool";

export function getStaticPaths() {
  return monthlyData.map((m) => ({
    params: { month: m.month },
    props: { month: m },
  }));
}

const { month } = Astro.props;
const canonical = `https://www.best-time-to-visit-china.com/month/${month.month}/`;
const MONTH_INDEX = { january:0, february:1, march:2, april:3, may:4, june:5, july:6, august:7, september:8, october:9, november:10, december:11 };
const now = new Date();
const currentYear = now.getFullYear() + ((MONTH_INDEX[month.month] < now.getMonth() && month.month !== "august") ? 1 : 0); // August: keep current year for now (user requested no roll)

// Match best regions to region guide slugs for internal linking (shared with region pages)
const relatedRegions = (monthRegionSlugs[month.month] ?? [])
  .map((slug) => regionGuides.find((r) => r.slug === slug))
  .filter((r): r is NonNullable<typeof r> => Boolean(r));

const title = `China Weather in ${month.label} ${currentYear}: Temp, Rain & Best Regions`;
const seoTitle = `China Weather in ${month.label} ${currentYear}: ${month.tempLow}–${month.tempHigh}°C`;
const meta = `${month.label} China weather: ${month.tempLow}–${month.tempHigh}°C, ${month.rainDays} rain days. See best regions, packing list & crowd tips. Real 10-year data.`;
const desc = `Planning a China trip in ${month.label}? Get ${month.tempLow}–${month.tempHigh}°C weather, ${month.rainDays} rainy days, best regions to visit & insider tips to avoid crowds.`;

const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": meta,
  "author": { "@type": "Person", "name": "Wei Zhang", "url": "https://www.best-time-to-visit-china.com/about/" },
  "publisher": { "@type": "Organization", "name": "When to Visit China", "logo": { "@type": "ImageObject", "url": "https://www.best-time-to-visit-china.com/favicon.svg" } },
  "datePublished": "2026-01-15",
  "dateModified": "2026-09-03",
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonical },
});
---

<BaseLayout title={seoTitle} description={meta} ogImage={month.image}>
  <script type="application/ld+json" set:html={articleSchema} />
  {month.faq && month.faq.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": month.faq.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    })} />
  )}

  <section class="min-h-[100dvh]">
    <Nav />
    <div class="max-w-4xl mx-auto px-4 py-8">
      <p class="text-sm font-medium tracking-wide text-accent-600 uppercase mb-4">Month Guide</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-zinc-900 mb-4 leading-none">{title}</h1>
      <p class="text-lg text-zinc-500 leading-relaxed mb-10">{desc}</p>

      <img src={month.image} srcset={imgSrcset(month.image)} sizes="(min-width: 1024px) 896px, 92vw" alt={month.imageAlt} width="1200" height="800" fetchpriority="high" class="w-full h-auto rounded-2xl shadow-sm border border-zinc-100 mb-12" />

      <!-- Quick answer box -->
      <div class="bg-accent-50 border border-accent-200 rounded-2xl p-6 mb-12">
        <p class="text-xs font-bold tracking-widest text-accent-700 uppercase mb-2">The Short Answer</p>
        <p class="text-zinc-800 text-base leading-relaxed">In {month.label}, China&rsquo;s temperatures average <strong class="text-accent-700">{month.tempLow}&deg;C to {month.tempHigh}&deg;C</strong>, with about {month.rainDays} rainy days and a crowd level of <strong class="text-accent-700">{month.crowdLevel}/5</strong>. It&rsquo;s best for <strong class="text-accent-700">{month.bestFor}</strong>.</p>
      </div>

      <!-- At a glance -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
        <div class="bg-white border border-zinc-200 rounded-xl p-4">
          <p class="text-xs font-semibold tracking-wide text-zinc-400 uppercase mb-1">Temperature</p>
          <p class="text-lg font-bold text-zinc-800">{month.tempLow}&deg;C - {month.tempHigh}&deg;C</p>
        </div>
        <div class="bg-white border border-zinc-200 rounded-xl p-4">
          <p class="text-xs font-semibold tracking-wide text-zinc-400 uppercase mb-1">Rain Days</p>
          <p class="text-lg font-bold text-zinc-800">{month.rainDays}</p>
        </div>
        <div class="bg-white border border-zinc-200 rounded-xl p-4">
          <p class="text-xs font-semibold tracking-wide text-zinc-400 uppercase mb-1">Crowd Level</p>
          <p class={`text-lg font-bold ${month.crowdLevel <= 2 ? 'text-emerald-600' : month.crowdLevel <= 3 ? 'text-amber-600' : 'text-red-600'}`}>{month.crowdLevel}/5</p>
        </div>
        <div class="bg-white border border-zinc-200 rounded-xl p-4">
          <p class="text-xs font-semibold tracking-wide text-zinc-400 uppercase mb-1">Best for</p>
          <p class="text-sm font-medium text-zinc-700 leading-snug">{month.bestFor}</p>
        </div>
      </div>

      <!-- Best regions -->
      <h2 class="text-2xl font-bold text-zinc-900 mb-6">Where to Go in {month.label}</h2>
      <div class="mb-12">
        <ul class="space-y-2">
          {month.bestRegions.map((r) => (
            <li class="flex items-center gap-3 text-sm text-zinc-700">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-accent-100 text-accent-700 flex items-center justify-center"><Icon name="star" class="w-3 h-3" /></span>
              {r}
            </li>
          ))}
        </ul>
        {relatedRegions.length > 0 && (
          <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {relatedRegions.map((r) => (
              <a href={`/region/${r.slug}/`} class="group bg-white border border-zinc-200 rounded-xl p-4 hover:border-accent-300 transition-colors no-underline">
                <p class="text-sm font-bold text-zinc-900 group-hover:text-accent-600 transition-colors">{r.name}</p>
                <p class="text-xs text-blue-700 font-medium mt-0.5">Best: {r.best}</p>
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Regional weather table -->
      {month.regionalWeather && month.regionalWeather.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">{month.label} Weather by Region</h2>
          <div class="overflow-x-auto border border-zinc-200 rounded-xl">
            <table class="w-full text-sm">
              <thead class="bg-zinc-50 text-zinc-500">
                <tr>
                  <th class="text-left font-semibold p-3">Region</th>
                  <th class="text-left font-semibold p-3">Avg Temperature</th>
                  <th class="text-left font-semibold p-3">Rainy Days</th>
                  <th class="text-left font-semibold p-3">Conditions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-zinc-100">
                {month.regionalWeather.map((rw) => (
                  <tr>
                    <td class="p-3 font-medium text-zinc-800">{rw.region}</td>
                    <td class="p-3 text-zinc-700">{rw.temp}</td>
                    <td class="p-3 text-zinc-700">{rw.rain}</td>
                    <td class="p-3 text-zinc-600">{rw.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}

      <!-- Interactive tools -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold text-zinc-900 mb-2">Plan Your Trip: Compare &amp; Decide</h2>
        <p class="text-sm text-zinc-500 mb-6">Interactive tools to compare {month.label} against other months, scan regional weather at a glance, and check flight &amp; hotel costs before you book.</p>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <ChinaMap client:visible />
          <div class="flex flex-col gap-6">
            <CostChart client:visible />
            <HotelComparison client:visible />
          </div>
        </div>
        <div class="mt-6">
          <ComparisonTool client:visible initialMode="months" initialA={month.month} initialB="october" />
        </div>
      </section>

      <!-- Top destinations -->
      {month.topDestinations && month.topDestinations.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">Top Places to Visit in {month.label}</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {month.topDestinations.map((d, i) => (
              <div class="bg-white border border-zinc-200 rounded-xl p-5">
                <div class="flex items-baseline gap-2 mb-1">
                  <span class="text-accent-600 font-bold">{i + 1}.</span>
                  <h3 class="text-base font-bold text-zinc-900">{d.name}</h3>
                </div>
                <p class="text-xs font-semibold text-zinc-400 uppercase tracking-wide mb-2">{d.temp}</p>
                <p class="text-sm text-zinc-700 leading-relaxed">{d.why}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Tips -->
      {month.tips && month.tips.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">How to Beat the Crowds &amp; Heat in {month.label}</h2>
          <ol class="space-y-3">
            {month.tips.map((t) => (
              <li class="flex gap-3 text-sm text-zinc-700 leading-relaxed">
                <span class="flex-shrink-0 mt-0.5 w-5 h-5 rounded-full bg-accent-100 text-accent-700 flex items-center justify-center text-xs font-bold">•</span>
                <span>{t}</span>
              </li>
            ))}
          </ol>
        </section>
      )}

      <!-- Verdict -->
      {month.verdict && (
        <section class="bg-accent-50 border border-accent-200 rounded-2xl p-6 mb-12">
          <p class="text-xs font-bold tracking-widest text-accent-700 uppercase mb-2">Is {month.label} Worth Visiting?</p>
          <p class="text-zinc-800 text-base leading-relaxed">{month.verdict}</p>
        </section>
      )}

      <!-- Highlights vs downsides -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        <div class="bg-blue-50/50 border border-blue-200 rounded-xl p-6">
          <p class="text-xs font-bold tracking-wide text-blue-700 uppercase mb-3">Highlights</p>
          <ul class="space-y-2">
            {month.highlights.map((h) => (
              <li class="flex gap-2.5 text-sm text-zinc-700 leading-relaxed">
                <span class="flex-shrink-0 mt-0.5 w-5 h-5 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center"><Icon name="check" class="w-3 h-3" /></span>
                {h}
              </li>
            ))}
          </ul>
        </div>
        <div class="bg-amber-50/50 border border-amber-200 rounded-xl p-6">
          <p class="text-xs font-bold tracking-wide text-amber-700 uppercase mb-3">Watch Out For</p>
          <ul class="space-y-2">
            {month.downsides.map((d) => (
              <li class="flex gap-2.5 text-sm text-zinc-700 leading-relaxed">
                <span class="flex-shrink-0 mt-0.5 w-5 h-5 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center"><Icon name="xmark" class="w-3 h-3" /></span>
                {d}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Packing -->
      <div class="bg-zinc-50 border border-zinc-100 rounded-xl p-6 mb-12">
        <p class="text-xs font-bold tracking-wide text-accent-600 uppercase mb-2">What to Pack</p>
        <p class="text-sm text-zinc-700 leading-relaxed mb-4">{month.packing}</p>
        {month.wardrobe && month.wardrobe.length > 0 && (
          <div class="grid gap-4 sm:grid-cols-2">
            {month.wardrobe.map((w) => (
              <div class="bg-white border border-zinc-200 rounded-lg p-4">
                <p class="text-sm font-semibold text-zinc-900 mb-2">{w.region}</p>
                <ul class="space-y-1.5">
                  {w.items.map((it) => (
                    <li class="flex gap-2 text-sm text-zinc-700 leading-snug">
                      <span class="flex-shrink-0 mt-0.5 w-4 h-4 rounded-full bg-accent-100 text-accent-700 flex items-center justify-center text-[10px]">✓</span>
                      {it}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- Budget Guide -->
      {month.budget && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">{month.label} Budget Guide</h2>
          <div class="bg-white border border-zinc-200 rounded-xl p-6">
            <div class="grid grid-cols-2 gap-4 mb-4">
              <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-4">
                <p class="text-xs font-semibold text-emerald-700 uppercase mb-1">Budget Travel</p>
                <p class="text-lg font-bold text-emerald-800">${month.budget.dailyLow}/day</p>
              </div>
              <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <p class="text-xs font-semibold text-blue-700 uppercase mb-1">Mid-Range</p>
                <p class="text-lg font-bold text-blue-800">${month.budget.dailyHigh}/day</p>
              </div>
            </div>
            <ul class="space-y-2">
              {month.budget.tips.map((tip) => (
                <li class="flex gap-2.5 text-sm text-zinc-700 leading-relaxed">
                  <span class="flex-shrink-0 mt-0.5 w-5 h-5 rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center"><Icon name="check" class="w-3 h-3" /></span>
                  {tip}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Transportation Tips -->
      {month.transportation && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">Getting There & Around</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="bg-white border border-zinc-200 rounded-xl p-5">
              <p class="text-xs font-bold tracking-wide text-accent-600 uppercase mb-2">Flights</p>
              <p class="text-sm text-zinc-700 leading-relaxed">{month.transportation.flightTips}</p>
            </div>
            <div class="bg-white border border-zinc-200 rounded-xl p-5">
              <p class="text-xs font-bold tracking-wide text-accent-600 uppercase mb-2">Trains</p>
              <p class="text-sm text-zinc-700 leading-relaxed">{month.transportation.trainTips}</p>
            </div>
            <div class="bg-white border border-zinc-200 rounded-xl p-5">
              <p class="text-xs font-bold tracking-wide text-accent-600 uppercase mb-2">Local Transport</p>
              <p class="text-sm text-zinc-700 leading-relaxed">{month.transportation.localTransport}</p>
            </div>
          </div>
        </section>
      )}

      <!-- Accommodation Guide -->
      {month.accommodation && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">Where to Stay</h2>
          <div class="bg-white border border-zinc-200 rounded-xl p-6">
            <div class="flex items-baseline gap-2 mb-4">
              <p class="text-xs font-semibold text-zinc-500 uppercase">Price Range:</p>
              <p class="text-lg font-bold text-zinc-800">${month.accommodation.rangeLow} – ${month.accommodation.rangeHigh}/night</p>
            </div>
            <div class="mb-4">
              <p class="text-xs font-semibold text-zinc-500 uppercase mb-2">Best Areas to Stay</p>
              <div class="flex flex-wrap gap-2">
                {month.accommodation.bestAreas.map((area) => (
                  <span class="px-3 py-1.5 bg-accent-50 text-accent-700 text-xs font-medium rounded-full">{area}</span>
                ))}
              </div>
            </div>
            <ul class="space-y-2">
              {month.accommodation.tips.map((tip) => (
                <li class="flex gap-2.5 text-sm text-zinc-700 leading-relaxed">
                  <span class="flex-shrink-0 mt-0.5 w-5 h-5 rounded-full bg-accent-100 text-accent-700 flex items-center justify-center"><Icon name="check" class="w-3 h-3" /></span>
                  {tip}
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Food & Dining -->
      {month.food && month.food.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">What to Eat in {month.label}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {month.food.map((item) => (
              <div class="flex items-center gap-3 bg-white border border-zinc-200 rounded-xl p-4">
                <span class="flex-shrink-0 w-8 h-8 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center text-sm">🍜</span>
                <p class="text-sm text-zinc-700">{item}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Cultural Events -->
      {month.culturalEvents && month.culturalEvents.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">Festivals & Events in {month.label}</h2>
          <div class="flex flex-wrap gap-2">
            {month.culturalEvents.map((event) => (
              <a href="/festivals/" class="px-4 py-2 bg-accent-50 text-accent-700 text-sm font-medium rounded-full hover:bg-accent-100 transition-colors no-underline">{event}</a>
            ))}
          </div>
        </section>
      )}

      <!-- Photography Tips -->
      {month.photographyTips && month.photographyTips.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">Photography Tips for {month.label}</h2>
          <div class="bg-zinc-50 border border-zinc-100 rounded-xl p-6">
            <ul class="space-y-3">
              {month.photographyTips.map((tip) => (
                <li class="flex gap-3 text-sm text-zinc-700 leading-relaxed">
                  <span class="flex-shrink-0 mt-0.5 w-5 h-5 rounded-full bg-zinc-200 text-zinc-700 flex items-center justify-center text-xs">📷</span>
                  <span>{tip}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )}

      <!-- Traveler Ratings -->
      {(month.familyFriendly || month.soloTravel) && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">Is {month.label} Good For You?</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {month.familyFriendly && (
              <div class="bg-white border border-zinc-200 rounded-xl p-5">
                <div class="flex items-center gap-2 mb-3">
                  <p class="text-sm font-bold text-zinc-900">Family Travel</p>
                  <div class="flex gap-0.5">
                    {[1,2,3,4,5].map((i) => (
                      <span class={`w-4 h-4 rounded-full ${i <= month.familyFriendly!.rating ? 'bg-emerald-500' : 'bg-zinc-200'}`}></span>
                    ))}
                  </div>
                </div>
                <ul class="space-y-1.5">
                  {month.familyFriendly.tips.map((tip) => (
                    <li class="text-xs text-zinc-600 leading-relaxed">• {tip}</li>
                  ))}
                </ul>
              </div>
            )}
            {month.soloTravel && (
              <div class="bg-white border border-zinc-200 rounded-xl p-5">
                <div class="flex items-center gap-2 mb-3">
                  <p class="text-sm font-bold text-zinc-900">Solo Travel</p>
                  <div class="flex gap-0.5">
                    {[1,2,3,4,5].map((i) => (
                      <span class={`w-4 h-4 rounded-full ${i <= month.soloTravel!.rating ? 'bg-emerald-500' : 'bg-zinc-200'}`}></span>
                    ))}
                  </div>
                </div>
                <ul class="space-y-1.5">
                  {month.soloTravel.tips.map((tip) => (
                    <li class="text-xs text-zinc-600 leading-relaxed">• {tip}</li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      )}

      <!-- FAQ -->
      {month.faq && month.faq.length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">Frequently Asked Questions</h2>
          <div class="space-y-4">
            {month.faq.map((f) => (
              <div class="bg-white border border-zinc-200 rounded-xl p-5">
                <h3 class="text-base font-bold text-zinc-900 mb-2">{f.q}</h3>
                <p class="text-sm text-zinc-700 leading-relaxed">{f.a}</p>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Best Regions This Month -->
      {monthRegionSlugs[month.month] && monthRegionSlugs[month.month].length > 0 && (
        <section class="mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">Best Regions to Visit in {month.label}</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {monthRegionSlugs[month.month].map((regionSlug) => {
              const regionName = regionSlug.charAt(0).toUpperCase() + regionSlug.slice(1);
              return (
                <a href={`/region/${regionSlug}/`} class="flex items-center gap-3 bg-white border border-zinc-200 rounded-xl p-4 hover:border-accent-300 hover:bg-accent-50/30 transition-colors no-underline">
                  <span class="flex-shrink-0 w-8 h-8 rounded-full bg-accent-100 text-accent-700 flex items-center justify-center text-xs">📍</span>
                  <span class="text-sm font-medium text-zinc-700">{regionName}</span>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <!-- Related Resources -->
      <section class="mb-12 bg-zinc-50 border border-zinc-100 rounded-xl p-6">
        <h2 class="text-lg font-bold text-zinc-900 mb-4">Plan Your China Trip</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <a href="/crowd-calendar/" class="flex items-center gap-2 text-sm text-accent-600 hover:text-accent-700 no-underline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Crowd Calendar
          </a>
          <a href="/travel-cost/" class="flex items-center gap-2 text-sm text-accent-600 hover:text-accent-700 no-underline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            Travel Cost Guide
          </a>
          <a href="/festivals/" class="flex items-center gap-2 text-sm text-accent-600 hover:text-accent-700 no-underline">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            Festivals & Events
          </a>
        </div>
      </section>

      <!-- Prev / Next month -->
      <div class="flex flex-col sm:flex-row justify-between gap-3 border-t border-zinc-100 pt-8 mb-4">
        {(() => {
          const idx = monthlyData.findIndex((m) => m.month === month.month);
          const prev = idx > 0 ? monthlyData[idx - 1] : null;
          const next = idx < monthlyData.length - 1 ? monthlyData[idx + 1] : null;
          return (
            <>
              {prev ? (
                <a href={`/month/${prev.month}/`} class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-accent-600 transition-colors no-underline">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
                  Previous: {prev.label}
                </a>
              ) : <span />}
              {next && (
                <a href={`/month/${next.month}/`} class="inline-flex items-center gap-1.5 text-sm font-medium text-zinc-500 hover:text-accent-600 transition-colors no-underline">
                  Next: {next.label}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                </a>
              )}
            </>
          );
        })()}
      </div>

      <!-- All 12 months nav (internal link cluster) -->
      <section class="mb-8">
        <h2 class="text-xl font-bold text-zinc-900 mb-4">Browse All 12 Months</h2>
        <div class="flex flex-wrap gap-2">
          {monthlyData.map((m) => (
            m.month === month.month
              ? <span class="px-3 py-1.5 rounded-full text-xs font-medium bg-accent-600 text-white">{m.label}</span>
              : <a href={`/month/${m.month}/`} class="px-3 py-1.5 rounded-full text-xs font-medium bg-white border border-zinc-200 text-zinc-600 hover:border-accent-300 hover:text-accent-600 transition-colors no-underline">{m.label}</a>
          ))}
        </div>
      </section>

      <div class="text-center">
        <a href="/monthly-guide/" class="inline-flex items-center gap-1.5 text-sm font-medium text-accent-600 hover:text-accent-700 transition-colors">
          Compare all 12 months side by side
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>
