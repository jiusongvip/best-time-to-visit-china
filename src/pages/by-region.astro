---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { regionGuides } from "../data/regions.ts";
---

<BaseLayout title="Best Time to Visit China by Region: 8 Zones Compared" description="China's climate varies dramatically by region. Compare the best travel seasons for Beijing, Shanghai, Xi'an, Guilin, Tibet, Yunnan & more with our regional guide.">
  <section class="min-h-[100dvh]">
    <Nav />
    <div class="max-w-7xl mx-auto px-4 py-6">
      <p class="text-sm font-medium tracking-wide text-accent-600 uppercase mb-4">By Region</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-zinc-900 mb-4 leading-none">When Is the Best Time to Visit China by Region?</h1>
      <p class="text-lg text-zinc-500 max-w-2xl leading-relaxed mb-16">China spans five climate zones. Each region has its own perfect season --- here is exactly when to go where, and what it costs.</p>

      <!-- Quick nav by question -->
      <div class="mb-16">
        <p class="text-sm font-medium tracking-wide text-accent-600 uppercase mb-4">Jump to Your Region</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {regionGuides.map((r) => (
            <a href={`#${r.slug}`} class="flex items-center gap-2 text-sm font-medium text-zinc-700 hover:text-accent-600 transition-colors no-underline">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-accent-100 text-accent-700 text-[10px] font-bold flex items-center justify-center">?</span>
              {r.question}
            </a>
          ))}
        </div>
      </div>

      <h2 class="text-2xl font-bold text-zinc-900 mb-10">8 Regions Compared</h2>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {regionGuides.map((r) => (
          <div id={r.slug} class="bg-white border border-zinc-200 rounded-2xl overflow-hidden hover:border-accent-200 transition-colors scroll-mt-24">
            <a href={`/region/${r.slug}`} class="relative block overflow-hidden no-underline group">
              <img src={r.image} alt={r.imageAlt} width="1200" height="800" loading="lazy" class="w-full h-56 md:h-64 object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-zinc-950/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-5">
                <p class="text-xs font-bold tracking-widest uppercase text-accent-300 mb-1">{r.shortName}</p>
                <h3 class="text-xl md:text-2xl font-bold tracking-tight text-white leading-snug group-hover:text-accent-200 transition-colors">{r.question}</h3>
              </div>
            </a>
            <div class="p-6 md:p-8 space-y-4">
              <div class="flex items-start gap-3">
                <span class="flex-shrink-0 px-2.5 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-700">Best</span>
                <p class="text-sm text-zinc-700">{r.best}</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="flex-shrink-0 px-2.5 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-600">Avoid</span>
                <p class="text-sm text-zinc-600">{r.avoid}</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="flex-shrink-0 px-2.5 py-1 rounded-full text-xs font-semibold bg-zinc-100 text-zinc-600">Ideal</span>
                <p class="text-sm text-zinc-700">{r.months} * {r.temp}</p>
              </div>
              <div>
                <p class="text-xs font-semibold text-zinc-400 mb-1">Must-See</p>
                <p class="text-sm text-zinc-700">{r.highlights}</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="flex-shrink-0 px-2.5 py-1 rounded-full text-xs font-semibold bg-sky-100 text-sky-700">Cost</span>
                <p class="text-sm text-zinc-700">{r.budget}</p>
              </div>
              <div class="bg-zinc-50 rounded-lg p-3 border border-zinc-100">
                <p class="text-xs font-semibold text-accent-600 mb-0.5">Local Tip</p>
                <p class="text-sm text-zinc-600">{r.tip}</p>
              </div>
              <a href={`/region/${r.slug}`} class="inline-flex items-center gap-1.5 text-sm font-medium text-accent-600 hover:text-accent-700 transition-colors no-underline">
                Read the full {r.shortName} guide
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>

      <h2 class="text-2xl font-bold text-zinc-900 mt-12 mb-6">Regional Travel Tips</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="bg-white border border-zinc-200 rounded-xl p-5">
          <h3 class="text-lg font-bold text-zinc-900 mb-2">Book Early for Peak Season</h3>
          <p class="text-sm text-zinc-600">For April-May and September-October (the best windows for most regions), book flights and hotels 2-3 months ahead. Prices surge 30-50% during these months.</p>
        </div>
        <div class="bg-white border border-zinc-200 rounded-xl p-5">
          <h3 class="text-lg font-bold text-zinc-900 mb-2">Avoid Golden Week Everywhere</h3>
          <p class="text-sm text-zinc-600">October 1-7 is the worst travel week in China. Every region is overwhelmed. If you must visit, arrive after October 8 for perfect weather and empty attractions.</p>
        </div>
        <div class="bg-white border border-zinc-200 rounded-xl p-5">
          <h3 class="text-lg font-bold text-zinc-900 mb-2">Mix Regions for Variety</h3>
          <p class="text-sm text-zinc-600">A 2-week trip can combine two regions: Beijing + Xi'an for history, Shanghai + Guilin for scenery, or Chengdu + Yunnan for food and nature.</p>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>
