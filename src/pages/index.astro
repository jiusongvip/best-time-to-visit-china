---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import { monthlyData } from "../data/weather.ts";
// TEMP: disable react islands for debugging
// import CostChart from "../components/islands/CostChart";
// import HotelComparison from "../components/islands/HotelComparison";
// import ChinaMap from "../components/islands/ChinaMap";
// import ComparisonTool from "../components/islands/ComparisonTool";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";

const pageTitle = "Best Time to Visit China 2026: Month-by-Month Guide";
const pageDesc = "Find the best time to visit China with our interactive guide. Compare weather, crowds & costs by month and region, then take the free 60-second quiz.";

const quickFacts = [
  { label: "Overall Best", value: "April-May & Sept-Oct", icon: "M5 13l4 4L19 7" },
  { label: "Cheapest", value: "Nov-Feb (excl. CNY)", icon: "M12 1v22M17 5H7a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2z" },
  { label: "Avoid", value: "CNY & National Day Week", icon: "M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" },
];

const travelPurposes = [
  { label: "Outdoor / Hiking", best: "Sep-Oct", desc: "Clear skies, cool temps --- Great Wall, Yellow Mountains, Tiger Leaping Gorge.", accent: "bg-blue-50 text-blue-700 border-blue-200" },
  { label: "Photography / Nature", best: "Mar-Apr", desc: "Cherry blossoms, spring colors, fewer tourists at iconic spots.", accent: "bg-sky-50 text-sky-700 border-sky-200" },
  { label: "Culture / Festivals", best: "Jan-Feb", desc: "Chinese New Year, lantern festivals, temple fairs. Authentic cultural immersion.", accent: "bg-indigo-50 text-indigo-700 border-indigo-200" },
  { label: "Food & Culinary", best: "Sep-Nov", desc: "Autumn harvest, hairy crab season, Mid-Autumn mooncakes.", accent: "bg-cyan-50 text-cyan-700 border-cyan-200" },
];

const regions = ["North (Beijing)", "East (Shanghai)", "South (Guangzhou)", "West (Chengdu)", "Southwest (Yunnan)", "Tibet"];
const regionMonths = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const regionData: Record<string, (1|2|3)[]> = {
  "North (Beijing)": [2,2,3,3,3,3,2,2,3,3,3,2],
  "East (Shanghai)": [2,2,3,3,3,2,1,1,3,3,3,2],
  "South (Guangzhou)": [3,3,2,2,2,1,1,1,2,3,3,3],
  "West (Chengdu)": [2,2,3,3,3,2,2,2,3,3,3,2],
  "Southwest (Yunnan)": [3,3,3,3,2,1,1,1,3,3,3,3],
  "Tibet": [1,1,1,2,3,3,3,3,3,3,1,1],
};

// One-line charm for each month (the "anytime" pitch)
const monthCharm: Record<string, string> = {
  january: "Harbin Ice & Snow Festival",
  february: "Chinese New Year lanterns",
  march: "Cherry blossoms bloom",
  april: "Great Wall hiking weather",
  may: "Yellow Mountains at their peak",
  june: "Lush green Zhangjiajie",
  july: "Escape to Tibet & Qinghai",
  august: "Inner Mongolia grasslands",
  september: "Golden Jiuzhaigou",
  october: "Peak autumn colors",
  november: "Crowd-free ancient cities",
  december: "Shanghai Christmas lights",
};

const travelerStories = [
  { name: "Sarah from London", quote: "Went in early April. The Great Wall was warm, not crowded, and the cherry blossoms in Beijing were unforgettable.", verdict: "Spring --- nailed it", verdictColor: "text-emerald-600 bg-emerald-50", trip: "Beijing, 10 days, ~£1,400" },
  { name: "Mike from Austin", quote: "Booked during Golden Week by mistake. The Forbidden City felt like a subway at rush hour. Never again.", verdict: "Golden Week --- disaster", verdictColor: "text-red-600 bg-red-50", trip: "Beijing + Xi'an, 7 days, ~\$2,200" },
  { name: "Anna from Sydney", quote: "Tibet in late July was perfect. Warm days, cool nights, and I shared the Potala Palace with maybe 30 people.", verdict: "Summer Tibet --- gem", verdictColor: "text-emerald-600 bg-emerald-50", trip: "Lhasa + Everest Base Camp, 12 days, ~A\$3,100" },
];

const faqs = [
  { q: "What is the best month to visit China?", a: "April, May, September, and October are generally the best months across China's most popular destinations. You'll get comfortable temperatures (15-26°C), manageable rainfall, and beautiful scenery --- spring blooms or autumn colors depending on the season." },
  { q: "When is the cheapest time to travel to China?", a: "November through February (excluding the Chinese New Year week) offers the lowest flight and hotel prices. Flights from the US can drop below \$600 round-trip, and 4-star hotels often run 40-50% below peak rates." },
  { q: "What is the worst time to visit China?", a: "Two periods to seriously reconsider: Chinese New Year (late Jan / early Feb) when the entire country is in transit and many businesses close, and National Day Golden Week (Oct 1-7) when every major attraction is packed. July-August is also punishingly hot and humid in most cities." },
  { q: "Is China crowded during Golden Week?", a: "Extremely. Golden Week (Oct 1-7) is the busiest travel period in the world, with hundreds of millions of domestic trips. Popular sites like the Forbidden City sell out days in advance. If you must travel near October, go after the 8th." },
  { q: "What is the weather like in China in October?", a: "October is arguably China's best weather month. Beijing averages 10-19°C with crisp, clear skies and autumn foliage. Shanghai is 17-23°C. Just avoid the first week (Golden Week) and you'll have a near-perfect trip." },
  { q: "Can I visit China during Chinese New Year?", a: "Yes, but with caveats. The festival atmosphere is incredible --- lanterns, temple fairs, fireworks. However, transportation is chaotic, many restaurants and shops close for 3-7 days, and prices surge. If cultural immersion is your goal, it's worth it; if convenience matters more, choose another time." },
  { q: "When is the rainy season in China?", a: "Southern China (Shanghai, Guangzhou, Guilin) sees heavy rain from June through August, with typhoon risk on the southeast coast peaking in August. Northern China is much drier. The “plum rain” season (meiyu) in June-July affects the Yangtze River basin." },
];

const faqPageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a },
  })),
});
---

<BaseLayout title={pageTitle} description={pageDesc} ogImage="/images/og-china-best-time.webp">
  <!-- JSON-LD Schema -->
  <script type="application/ld+json" set:html={`{
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "${pageTitle}",
    "description": "${pageDesc}",
    "author": { "@type": "Person", "name": "Wei Zhang", "url": "https://when-to-visit-china.com/about" },
    "publisher": { "@type": "Organization", "name": "When to Visit China", "logo": { "@type": "ImageObject", "url": "https://when-to-visit-china.com/favicon.svg" } },
    "datePublished": "2026-01-15",
    "dateModified": "2026-07-31",
    "mainEntityOfPage": { "@type": "WebPage", "@id": "https://when-to-visit-china.com" },
    "image": "https://when-to-visit-china.com/images/og-china-best-time.webp"
  }`} />
  <!-- FAQPage Schema (AI citation signal) -->
  <script type="application/ld+json" set:html={faqPageSchema} />

  <!-- ======== NAV ======== -->
  <nav class="sticky top-0 z-50 bg-white/80 backdrop-blur-md border-b border-zinc-100">
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
      <a href="/" class="text-lg font-semibold tracking-tight text-zinc-900">When to Visit China</a>
      <div class="hidden md:flex items-center gap-4 text-sm font-medium text-zinc-600">
        <a href="/when-to-go" class="hover:text-accent-600 transition-colors">Quiz</a>
        <a href="/monthly-guide" class="hover:text-accent-600 transition-colors">Monthly Guide</a>
        <a href="/by-region" class="hover:text-accent-600 transition-colors">By Region</a>
        <a href="/festivals" class="hover:text-accent-600 transition-colors">Festivals</a>
        <a href="/crowd-calendar" class="hover:text-accent-600 transition-colors">Crowds</a>
        <a href="/faq" class="hover:text-accent-600 transition-colors">FAQ</a>
        <a href="/travel-cost" class="hover:text-accent-600 transition-colors">Cost</a>
        <a href="/about" class="hover:text-accent-600 transition-colors">About</a>
        <a href="/when-to-go" class="ml-2 inline-flex items-center gap-1.5 px-4 py-2 bg-accent-600 text-white text-sm font-medium rounded-full hover:bg-accent-700 transition-colors no-underline">
          Take the Quiz
        </a>
      </div>
      <button id="menu-toggle" class="md:hidden p-2 text-zinc-600 hover:text-accent-600" aria-label="Open menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
    <div id="mobile-menu" class="hidden md:hidden border-t border-zinc-100 bg-white px-4 pb-4">
      <div class="flex flex-col gap-3 pt-4 text-sm font-medium text-zinc-600">
        <a href="/when-to-go" class="hover:text-accent-600 py-1">Quiz</a>
        <a href="/monthly-guide" class="hover:text-accent-600 py-1">Monthly Guide</a>
        <a href="/by-region" class="hover:text-accent-600 py-1">By Region</a>
        <a href="/festivals" class="hover:text-accent-600 py-1">Festivals</a>
        <a href="/crowd-calendar" class="hover:text-accent-600 py-1">Crowds</a>
        <a href="/faq" class="hover:text-accent-600 py-1">FAQ</a>
      </div>
    </div>
  </nav>

  <!-- ======== 1. HERO: TITLE OVER THE 12-MONTH IMAGE WALL ======== -->
  <section id="month-wall" class="bg-white">
    <div class="max-w-7xl mx-auto px-4 pt-12 md:pt-16">
      <div class="text-center mb-2">
        <p class="inline-flex items-center gap-2 text-xs font-semibold tracking-[0.2em] uppercase text-zinc-400 mb-6">
          <Icon name="calendar" class="w-3.5 h-3.5 text-accent-500" />
          12 months, 12 reasons to go
        </p>
        <h1 class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold tracking-tighter leading-[0.95] text-zinc-950">
          Best time to visit<br />
          <em class="font-normal italic">China</em>
        </h1>
        <p class="text-base md:text-lg text-zinc-500 leading-relaxed mt-6 mb-8 max-w-xl mx-auto">Almost all year round &mdash; every month has somewhere that shines.</p>
        <div class="flex flex-wrap justify-center gap-3 mb-4">
          <a href="/when-to-go" class="inline-flex items-center gap-2 px-7 py-3.5 bg-accent-600 hover:bg-accent-700 text-white font-semibold rounded-full transition-colors">
            Take the Free Quiz
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a href="/monthly-guide" class="inline-flex items-center gap-2 px-7 py-3.5 bg-white border border-zinc-300 text-zinc-900 font-semibold rounded-full hover:bg-zinc-50 transition-colors">
            Compare the Months
          </a>
        </div>
      </div>
    </div>
    <div class="max-w-7xl mx-auto px-4 pb-16">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 md:gap-4 items-start pt-8 lg:pt-28">
        {monthlyData.map((m, i) => {
          // Diagonal stagger rising toward the top-right (desktop only)
          const col = i % 4;
          const offset = col === 1 ? "lg:-mt-10" : col === 2 ? "lg:-mt-20" : col === 3 ? "lg:-mt-28" : "";
          return (
            <a href={`/month/${m.month}`} class={`group relative overflow-hidden rounded-2xl aspect-[4/5] block no-underline shadow-sm ${offset}`}>
              <img src={m.image} alt={m.imageAlt} width="1200" height="800" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/85 via-zinc-950/20 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-4 md:p-5">
                <p class="text-xs font-bold tracking-widest uppercase text-accent-300 mb-1">{m.label}</p>
                <p class="text-base md:text-lg font-bold leading-snug text-white group-hover:text-accent-200 transition-colors">{monthCharm[m.month]}</p>
                <div class="flex items-center gap-2 mt-2 text-xs text-zinc-300">
                  <span>{m.tempLow}&deg; to {m.tempHigh}&deg;C</span>
                  <span class="w-1 h-1 rounded-full bg-zinc-500"></span>
                  <span class="flex items-center gap-1">
                    {Array.from({length: m.crowdLevel}, () => <Icon name="users" class="w-3 h-3" />)}
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>
      <div class="mt-10 text-center">
        <a href="/monthly-guide" class="inline-flex items-center gap-1.5 text-sm font-medium text-accent-600 hover:text-accent-700 transition-colors">
          Compare all 12 months side by side
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ======== CURRENT SEASON BANNER ======== -->
  <div id="season-banner" class="hidden bg-accent-50 border-b border-accent-200">
    <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between flex-wrap gap-2">
      <p class="text-sm text-accent-800">
        <span class="font-semibold">Traveling to China in <span class="season-month"></span>?</span>
        Here is what you need to know &mdash; <a href="#month-wall" class="underline font-medium">find your month</a> or <a href="/when-to-go" class="underline font-medium">take the quiz</a>.
      </p>
    </div>
  </div>

  <!-- ======== 2. QUICK SUMMARY CARDS ======== -->
  <section class="reveal max-w-7xl mx-auto px-4 pt-8 relative z-10">
    <p class="text-center text-zinc-500 text-sm md:text-base max-w-3xl mx-auto mb-8 leading-relaxed">China is a continent-sized country, so honestly the best time to go is almost all year round &mdash; every month has somewhere that shines. For most travelers spring (April&ndash;May) and autumn (September&ndash;October) still win on weather and crowds, but the right answer depends on your region, budget, and travel style. Use this guide to compare weather, crowds, and costs.</p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {quickFacts.map((fact) => (
        <div class="bg-white rounded-2xl border border-zinc-200 shadow-sm p-6 flex items-start gap-4">
          <div class="flex-shrink-0 w-10 h-10 rounded-xl bg-accent-100 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-accent-600" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={fact.icon}/></svg>
          </div>
          <div>
            <p class="text-xs font-semibold tracking-wide text-zinc-400 uppercase mb-1">{fact.label}</p>
            <p class="text-sm font-semibold text-zinc-800 leading-snug">{fact.value}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- ======== NEW: INTERACTIVE MAP ======== -->
  <section class="reveal max-w-7xl mx-auto px-4 py-16" id="china-map">
    <div class="mb-12">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-zinc-400 mb-5">Where to Go</p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-[1.02] text-zinc-900 mb-5">China is a continent-<br /><em class="font-normal italic">sized country</em></h2>
      <p class="text-zinc-500 max-w-2xl leading-relaxed">Every region has its own perfect season. Hover to see the best months, then click for the full guide.</p>
    </div>
    <div class="text-center text-zinc-400 py-8 border border-dashed border-zinc-200 rounded-xl">Interactive Map (disabled for debug)</div>
  </section>

  <!-- ======== COMPARISON TOOL ======== -->
  <section class="reveal max-w-7xl mx-auto px-4 py-16">
    <div class="mb-12">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-zinc-400 mb-5">Compare</p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-[1.02] text-zinc-900 mb-5">April or October?<br /><em class="font-normal italic">Beijing or Shanghai?</em></h2>
      <p class="text-zinc-500 max-w-2xl leading-relaxed">Stop opening multiple tabs. Compare any two months or regions side by side and get a clear verdict.</p>
    </div>
    <div class="text-center text-zinc-400 py-8 border border-dashed border-zinc-200 rounded-xl">Comparison Tool (disabled for debug)</div>
  </section>

  <!-- ======== 4. TRAVEL PURPOSE GRID ======== -->
  <section class="reveal bg-zinc-50 border-y border-zinc-100">
    <div class="max-w-7xl mx-auto px-4 py-20">
      <div class="mb-12">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-zinc-400 mb-5">Travel Style</p>
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-[1.02] text-zinc-900 mb-5">Your trip,<br /><em class="font-normal italic">your season</em></h2>
        <p class="text-zinc-500 max-w-2xl leading-relaxed">The best time depends on what you want to do. Match your travel style to the ideal season.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {travelPurposes.map((tp) => (
          <div class={`rounded-xl border p-6 ${tp.accent}`}>
            <p class="text-lg font-bold mb-1">{tp.label}</p>
            <p class="text-sm font-semibold mb-2">Best: {tp.best}</p>
            <p class="text-sm leading-relaxed opacity-80">{tp.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ======== ONLY SUMMER/WINTER (fixed-schedule travelers) ======== -->
  <section class="reveal max-w-7xl mx-auto px-4 py-20">
    <div class="mb-12">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-zinc-400 mb-5">Fixed Schedule</p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-[1.02] text-zinc-900 mb-5">Only summer or<br /><em class="font-normal italic">winter available?</em></h2>
      <p class="text-zinc-500 max-w-2xl leading-relaxed">Teachers, families, and busy professionals often have no choice but to travel during school holidays. Good news: you can still have a great China trip &mdash; you just need to plan smarter.</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="bg-white border border-zinc-200 rounded-2xl p-6 md:p-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="flex-shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-xl bg-blue-100 text-blue-600 text-sm font-bold">Sun</span>
          <h3 class="text-lg font-bold text-zinc-900">Summer (Jul-Aug): How to Beat the Crowds</h3>
        </div>
        <p class="text-sm text-zinc-600 leading-relaxed mb-4">Summer is China's peak season. These tactics keep the crowds manageable and the heat bearable.</p>
        <ol class="space-y-3">
          {[
            { t: "Skip the famous section, not the sight. Walk the Great Wall at Jinshanling or Jiankou instead of packed Badaling." },
            { t: "Go at opening (6 AM) or after 4 PM. Hotspots are busiest 10 AM-3 PM; evenings bring cooler air and better light." },
            { t: "Swap the obvious spot for a hidden gem. See restored warriors at Xi'an's Lintong Museum instead of dodging crowds in Pit 1." },
            { t: "Avoid August 1-15, the hottest peak of the peak. Late June is noticeably less crowded." },
            { t: "Head for altitude. Tibet, Yunnan's Dali/Lijiang, and Inner Mongolia stay refreshingly cool while the lowlands bake." },
          ].map((tip, i) => (
            <li class="flex gap-3 text-sm text-zinc-600 leading-relaxed">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-100 text-blue-700 text-xs font-bold flex items-center justify-center mt-0.5">{i + 1}</span>
              <span>{tip.t}</span>
            </li>
          ))}
        </ol>
      </div>
      <div class="bg-white border border-zinc-200 rounded-2xl p-6 md:p-8">
        <div class="flex items-center gap-3 mb-4">
          <span class="flex-shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-xl bg-sky-100 text-sky-700 text-sm font-bold">Snow</span>
          <h3 class="text-lg font-bold text-zinc-900">Winter (Dec-Feb): Fewer Crowds, Lower Prices</h3>
        </div>
        <p class="text-sm text-zinc-600 leading-relaxed mb-4">Winter is the cheapest, quietest season &mdash; as long as you dress warmly and pick the right destinations.</p>
        <ul class="space-y-3">
          {[
            { t: "Celebrate Harbin's Ice and Snow Festival &mdash; the largest on Earth, at -25°C." },
            { t: "Escape the cold in Hainan (Sanya beaches), or enjoy mild, sunny days in Yunnan." },
            { t: "Get flights from the US below $750 and 4-star hotels 40-50% off peak." },
            { t: "Walk a nearly empty Great Wall &mdash; with gloves and layers, it is magical." },
          ].map((tip) => (
            <li class="flex gap-3 text-sm text-zinc-600 leading-relaxed">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-sky-100 text-sky-700 flex items-center justify-center mt-0.5"><Icon name="check" class="w-3.5 h-3.5" /></span>
              <span>{tip.t}</span>
            </li>
          ))}
        </ul>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/festivals" class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2.5 border border-zinc-300 rounded-full hover:border-accent-400 hover:text-accent-600 transition-colors">Plan around a festival</a>
          <a href="/crowd-calendar" class="inline-flex items-center gap-1.5 text-sm font-medium px-4 py-2.5 border border-zinc-300 rounded-full hover:border-accent-400 hover:text-accent-600 transition-colors">Check crowd levels</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== 5. REGION MATRIX ======== -->
  <section class="reveal max-w-7xl mx-auto px-4 py-20">
    <div class="mb-12">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-zinc-400 mb-5">By Region</p>
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold tracking-tighter leading-[1.02] text-zinc-900 mb-5">China is not<br /><em class="font-normal italic">one climate</em></h2>
      <p class="text-zinc-500 max-w-2xl leading-relaxed">Northern China freezes while the south basks in sun. Check which regions shine each month.</p>
    </div>
    <div class="overflow-x-auto rounded-xl border border-zinc-200">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-zinc-200 bg-zinc-50">
            <th class="text-left p-3 font-semibold text-zinc-600 sticky left-0 bg-zinc-50 z-10">Region</th>
            {regionMonths.map(m => <th class="p-3 text-center font-semibold text-zinc-500 min-w-[3rem]">{m}</th>)}
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-100">
          {regions.map((region) => (
            <tr class="hover:bg-zinc-50/50 transition-colors">
